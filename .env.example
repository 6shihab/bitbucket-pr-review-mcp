# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so keep
# every value here a placeholder.
#
# Two different things read `.env`, which is worth knowing before you edit it:
#
#   * docker compose, for `${VAR}` interpolation in docker-compose.yaml. Only
#     variables the compose file actually names have any effect there.
#   * pydantic-settings (src/.../settings.py, env_prefix `BB_MCP_`), when you
#     run `uv run bb-pr-mcp` directly on the host. Unknown keys are ignored.
#
# The credential itself is not here. On a workstation it lives in the OS
# keychain (ADR-0003); for the per-device container it lives in `.env.docker`
# (ADR-0007); on the shared server each person connects their own through
# `/connect` and it is encrypted into the vault (ADR-0008).
# ---------------------------------------------------------------------------


# --- The public origin --------------------------------------------------------
# One origin serves both the MCP endpoint and Keycloak, on purpose: the issuer
# is a *string* that has to mean the same thing in the token, in the discovery
# document, in the browser, and in this file. See deploy/nginx.conf.
#
# No trailing slash. A token whose `iss` differs by one is refused, by design.
BB_MCP_PUBLIC_ORIGIN=https://mcp.example.com

# Derived from the origin, but stated rather than computed so a mismatch is
# visible instead of clever. `--health` refuses a non-https public URL anywhere
# but loopback, so terminate TLS in front of the proxy.
BB_MCP_PUBLIC_URL=https://mcp.example.com/mcp
BB_MCP_OIDC_ISSUER=https://mcp.example.com/realms/streamstech


# --- Secrets ------------------------------------------------------------------
# The two client secrets. The realm file reads both at import time, so setting
# them here is all it takes — there is no admin console step and no second copy
# to drift. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
#
# The `bitbucket-pr-review-web` client: this server, as an ordinary OAuth client,
# is how `/connect` makes a browser sign in before it will accept an Atlassian
# API token. Also read by the server itself, not just by Keycloak.
BB_MCP_OIDC_CLIENT_SECRET=replace-me

# The `bitbucket-pr-review` client: the one Claude holds. Paste the same value
# into the connector's Advanced settings, once, as an Owner.
BB_MCP_CONNECTOR_CLIENT_SECRET=replace-me

# How Keycloak treats plain http. `external` permits it on loopback, which is
# what the development stack needs; a public deployment wants `all`.
BB_MCP_SSL_REQUIRED=all

# Keycloak's bootstrap admin. Dev-mode default is admin/admin; a real
# deployment sets both from a secret store and does not keep them in a file.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me


# --- The vault ----------------------------------------------------------------
# Where the encryption key is on the *host*. Mounted read-only into the review
# container at /run/secrets/vault.key. Keep it outside this repository and out
# of the store's backups: a copy of the store must not also be a copy of the
# key. Rotating this makes every stored credential unreadable — people
# reconnect through /connect.
#
#   Linux/macOS:  /etc/bb-pr-mcp/vault.key
#   Windows:      C:/Users/you/.bb-pr-mcp/vault.key
#
# ABSOLUTE, always. A relative bind source is resolved against the project
# directory, so `./.bb-pr-mcp/vault.key` names a different file on a laptop than
# on a server; `~/...` is expanded by some Docker versions and not others.
#
# The file has to exist before the first `up`. Docker creates a missing bind
# source as a *directory*, and the resulting failure is a mount type error that
# mentions neither the key nor this variable.
#
# Generate one with either of:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#   uv run python -c "from bitbucket_pr_review_mcp.vault import VaultKey; print(VaultKey.generate().exported())"
BB_MCP_VAULT_KEY_PATH=/etc/bb-pr-mcp/vault.key

# Where the encrypted store lives inside the container. The compose file puts a
# named volume here — it is the one thing in this stack that must survive a
# restart.
BB_MCP_VAULT_FILE=/vault/credentials.sqlite3


# --- Tuning knobs -------------------------------------------------------------
# All optional; the defaults below are the real ones from settings.py.
BB_MCP_REPOSITORIES_FILE=config/repositories.yaml
BB_MCP_LOG_LEVEL=INFO
# One JSON object per line, for a log aggregator. Off by default because a
# person reading a terminal is the commoner case.
BB_MCP_LOG_JSON=false
BB_MCP_REQUEST_TIMEOUT_SECONDS=30.0

# Response ceilings. A caller reading past these is reviewing from memory, so
# each is stated in the response rather than silently applied (ADR-0005).
BB_MCP_MAX_CHANGED_FILES=300
BB_MCP_MAX_DIFF_CHARACTERS=60000
BB_MCP_MAX_FILE_CHARACTERS=40000
BB_MCP_MAX_DIRECTORY_ENTRIES=200
BB_MCP_MAX_COMMITS=50
BB_MCP_MAX_SEARCH_RESULTS=25
BB_MCP_MAX_COMMENTS=200

# The OAuth client this server authenticates to Keycloak as. Change only if you
# renamed the client in the realm.
BB_MCP_OIDC_CLIENT_ID=bitbucket-pr-review-web


# --- Keycloak's database ------------------------------------------------------
# Postgres holds the realm and every account. Without it Keycloak keeps them in
# memory and a restart loses them.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-me

# `start-dev` is the development default. `start` turns off the dev-mode
# conveniences and is what a public deployment wants.
KC_START_COMMAND=start

# The realm is imported once, into that database. `--import-realm` leaves an
# existing realm alone, so changing an origin or a secret above takes a
# re-import — drop that one volume by name:
#
#   docker compose --profile shared down
#   docker volume rm bitbucket-pr-review-mcp_keycloak-db
#   docker compose --profile shared up -d
#
# Not `down -v`, which removes every volume in the file — including the
# credential vault, which would make everybody connect their account again.
