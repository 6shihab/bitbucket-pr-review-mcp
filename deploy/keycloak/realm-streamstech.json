{
  "realm": "streamstech",
  "enabled": true,
  "displayName": "Streamstech",
  "sslRequired": "${BB_MCP_SSL_REQUIRED}",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clientScopes": [
    {
      "name": "basic",
      "description": "The claims every access token needs. Keycloak's built-in scope of this name carries them; declaring any clientScopes in a realm import replaces the built-in set, so it is restated here.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "bitbucket:review",
      "description": "Read pull requests and comment on them, as you.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read and comment on Bitbucket pull requests using your own account."
      },
      "protocolMappers": [
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${BB_MCP_PUBLIC_URL}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Who somebody is, for the page that connects their Bitbucket account. Restated here because declaring any clientScopes replaces Keycloak's built-in set.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "The signed-in person's email address, shown back on the connect page.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bitbucket-pr-review",
      "name": "Bitbucket PR Review (Claude connector)",
      "description": "The OAuth client Claude uses. Its id and secret are pasted into the connector's Advanced settings once, by an Owner.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BB_MCP_CONNECTOR_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://claude.ai/api/mcp/auth_callback",
        "http://localhost/callback",
        "http://127.0.0.1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access",
        "bitbucket:review"
      ]
    },
    {
      "clientId": "bitbucket-pr-review-web",
      "name": "Bitbucket PR Review (connect your account)",
      "description": "This server, as an ordinary OAuth client, so the page that collects an Atlassian API token can make the browser sign in first. Without it the page would be reachable by whoever holds its URL.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BB_MCP_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${BB_MCP_PUBLIC_ORIGIN}/connect/callback",
        "http://localhost:8080/connect/callback",
        "https://review.streamstech.com/connect/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "bitbucket-pr-review-cli",
      "name": "Bitbucket PR Review (local bridge)",
      "description": "For mcp-remote and Claude Code: a native client on a loopback port. Public rather than confidential, because a secret in a config file on a laptop is not a secret; PKCE is what protects this flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3334/oauth/callback",
        "http://localhost:3334/oauth/callback",
        "http://127.0.0.1:*/callback",
        "http://localhost:*/callback",
        "http://127.0.0.1:*/oauth/callback",
        "http://localhost:*/oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access",
        "bitbucket:review"
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@streamstech.com",
      "firstName": "Development",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-not-for-production",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-streamstech"
      ]
    }
  ]
}
